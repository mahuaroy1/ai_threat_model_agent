{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-threat-model",
          "version": "0.1.0",
          "rules": [
            {
              "id": "AITM-AUTH-001",
              "name": "LlmEntryPointHasNoDetectedAuthentication",
              "shortDescription": {
                "text": "LLM entry point has no detected authentication"
              },
              "help": {
                "text": "Require authentication and authorization on the endpoint, and add rate limits and usage quotas to protect model spend and connected tools."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM10 Unbounded Consumption",
                  "ASI03"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "AITM-DATA-001",
              "name": "HardCodedSecret",
              "shortDescription": {
                "text": "Hard-coded secret"
              },
              "help": {
                "text": "Revoke and rotate the credential, remove it from source and history, and load it from a secret manager or untracked environment configuration."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM02 Sensitive Information Disclosure",
                  "ASI03"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "AITM-DATA-002",
              "name": "SecretOrPersonalDataSentToAModel",
              "shortDescription": {
                "text": "Secret or personal data sent to a model"
              },
              "help": {
                "text": "Minimize and redact data before prompting. Confirm the provider's retention terms and keep credentials out of prompts entirely."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM02 Sensitive Information Disclosure"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "AITM-DATA-003",
              "name": "SensitiveDataWrittenToLogsOrDebugOutput",
              "shortDescription": {
                "text": "Sensitive data written to logs or debug output"
              },
              "help": {
                "text": "Disable verbose/debug modes in production and redact secrets and personal data before logging prompts, responses, or tool arguments."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM02 Sensitive Information Disclosure"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "AITM-DATA-004",
              "name": "PromptsAndOutputsExportedToAThirdPartyTracingService",
              "shortDescription": {
                "text": "Prompts and outputs exported to a third-party tracing service"
              },
              "help": {
                "text": "Confirm tracing is intended for this environment, mask inputs/outputs containing personal data, and review the vendor's retention policy."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM02 Sensitive Information Disclosure"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "AITM-DATA-005",
              "name": "CredentialEmbeddedInASystemPrompt",
              "shortDescription": {
                "text": "Credential embedded in a system prompt"
              },
              "help": {
                "text": "Assume system prompts can be extracted. Remove credentials and sensitive rules from prompts and enforce authorization outside the model."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM07 System Prompt Leakage",
                  "ASI03"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "AITM-ID-001",
              "name": "ToolTakesAnObjectOrIdentityReferenceFromTheModelConfusedDeputy",
              "shortDescription": {
                "text": "Tool takes an object or identity reference from the model (confused deputy)"
              },
              "help": {
                "text": "Inject the caller's identity into the tool (InjectedToolArg, InjectedState, or the RunnableConfig) and authorize every object access against it; never trust IDs chosen by the model."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM06 Excessive Agency",
                  "ASI03",
                  "ASI02"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "AITM-OUT-001",
              "name": "ModelOutputReachesADangerousSink",
              "shortDescription": {
                "text": "Model output reaches a dangerous sink"
              },
              "help": {
                "text": "Treat model output as untrusted input. Parse it into a validated structure and never pass it to eval, shells, raw SQL, file paths, or URLs."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM05 Improper Output Handling",
                  "ASI05",
                  "ASI02"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "AITM-OUT-002",
              "name": "ModelOutputRenderedAsTrustedHtmlOrTemplate",
              "shortDescription": {
                "text": "Model output rendered as trusted HTML or template"
              },
              "help": {
                "text": "HTML-escape model output, render it as text or sanitized Markdown, and never mark it as safe markup."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM05 Improper Output Handling",
                  "ASI09"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "AITM-PI-001",
              "name": "UntrustedInputConcatenatedIntoAPrompt",
              "shortDescription": {
                "text": "Untrusted input concatenated into a prompt"
              },
              "help": {
                "text": "Pass user input as a separate template variable or human message; never splice it into instructions. Delimit untrusted text and validate its length and format."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM01 Prompt Injection",
                  "ASI01"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "AITM-PI-003",
              "name": "IndirectPromptInjectionExternalContentReachesAnAgentWithPrivilegedTools",
              "shortDescription": {
                "text": "Indirect prompt injection: external content reaches an agent with privileged tools"
              },
              "help": {
                "text": "Treat retrieved and fetched content as data: isolate it from tool-calling agents, restrict tools to least privilege, and require human approval for side effects."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM01 Prompt Injection",
                  "ASI01",
                  "ASI06"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "AITM-SUP-001",
              "name": "AiFrameworkDependencyIsNotPinned",
              "shortDescription": {
                "text": "AI framework dependency is not pinned"
              },
              "help": {
                "text": "Pin exact versions (or use a lock file with hashes) for LangChain, LangGraph, and model SDK packages, and review updates before upgrading."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM03 Supply Chain",
                  "ASI04"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "AITM-TOOL-001",
              "name": "HighRiskBuiltInToolExposedToTheModel",
              "shortDescription": {
                "text": "High-risk built-in tool exposed to the model"
              },
              "help": {
                "text": "Remove the tool or replace it with a narrowly scoped tool that validates arguments, runs in a sandbox, and requires human approval."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM06 Excessive Agency",
                  "ASI02",
                  "ASI05"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "AITM-TOOL-003",
              "name": "ModelControlledToolArgumentReachesADangerousSink",
              "shortDescription": {
                "text": "Model-controlled tool argument reaches a dangerous sink"
              },
              "help": {
                "text": "Validate tool arguments against a strict schema and allow-list. Use parameterized queries, argument arrays without a shell, and path/URL allow-lists."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM06 Excessive Agency",
                  "ASI02",
                  "ASI05"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "AITM-TOOL-005",
              "name": "NoHumanApprovalBeforeSideEffectingToolCalls",
              "shortDescription": {
                "text": "No human approval before side-effecting tool calls"
              },
              "help": {
                "text": "Use LangGraph interrupts (interrupt_before / interrupt()) or human-in-the-loop middleware so a person approves destructive or external actions."
              },
              "properties": {
                "tags": [
                  "security",
                  "ai",
                  "LLM06 Excessive Agency",
                  "ASI02",
                  "ASI09"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
